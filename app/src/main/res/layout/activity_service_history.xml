
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Application Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service History"
            android:textColor="#173B70"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Welcome Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Record your vehicle maintenance details"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Select Vehicle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Vehicle"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spServiceVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- Service Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Service Date"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServiceDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="YYYY-MM-DD"
            android:inputType="date"
            android:focusable="false"
            android:clickable="true"
            android:importantForAutofill="no" />

        <!-- Service Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Service Type"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spServiceType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- Service Cost -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Service Cost (Rs.)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServiceCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter service cost"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Description"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServiceDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/service_description_hint"
            android:gravity="top"
            android:minHeight="100dp"
            android:minLines="3"
            android:inputType="textMultiLine"
            android:textColor="#222222"
            android:importantForAutofill="no" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="Save Service Record" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service History Records"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/serviceHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
